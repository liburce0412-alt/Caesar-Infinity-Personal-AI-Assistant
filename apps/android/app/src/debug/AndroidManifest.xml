<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="${caesarCloudNetworkSecurityConfig}">
        <activity android:name="com.campusai.debug.TimeBoundaryProbeActivity"
            android:exported="true" android:excludeFromRecents="true" android:launchMode="singleTask"
            android:permission="android.permission.DUMP" android:process=":time_acceptance"
            android:taskAffinity="${applicationId}.time_acceptance" />
        <activity android:name="com.campusai.debug.CaesarBoundaryProbeActivity"
            android:exported="true" android:excludeFromRecents="true" android:noHistory="true"
            android:permission="android.permission.DUMP" android:process=":caesar_boundary_probe" />
        <activity android:name="com.campusai.debug.CourseReminderProbeActivity" android:exported="true"
            android:excludeFromRecents="true" android:permission="android.permission.DUMP" />
        <activity android:name="com.campusai.debug.SpectraRenderProbeActivity"
            android:exported="true" android:excludeFromRecents="true" android:noHistory="true"
            android:permission="android.permission.DUMP" android:process=":spectra_probe" />
        <activity
            android:name="com.campusai.debug.PromoCaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.DUMP"
            android:process=":promo_capture" />
        <activity
            android:name="com.campusai.debug.CaesarEvalActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:process=":caesar_eval">
            <intent-filter>
                <action android:name="com.campusai.debug.RUN_CAESAR_EVAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
