<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.campusai.debug.PromoCaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.DUMP"
            android:process=":promo_capture" />
        <activity
            android:name="com.campusai.debug.CaesarEvalActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:process=":caesar_eval">
            <intent-filter>
                <action android:name="com.campusai.debug.RUN_CAESAR_EVAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
