[Unit]
Description=Mirror verified public Caesar APK releases
After=network-online.target

[Service]
Type=oneshot
User=www-data
ExecStart=/usr/bin/python3 /usr/local/lib/caesar-updater/sync-app-releases.py
TimeoutStartSec=10min
MemoryMax=96M
CPUQuota=20%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/campusai-updates
